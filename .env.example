# Firebase Console → 프로젝트 설정 → 내 앱 → 웹 앱의 Firebase 구성
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# 로컬 에뮬레이터를 사용할 때만 true
VITE_USE_FIREBASE_EMULATORS=false

# Optional public JavaScript app key for KakaoTalk sharing.
VITE_KAKAO_JS_KEY=

# Optional OAuth service; enable only after the Worker and providers are registered.
VITE_AUTH_API_URL=
