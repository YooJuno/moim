{
  "name": "moim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "dev:demo": "vite --host 0.0.0.0 --mode demo",
    "holidays:update": "node scripts/update-holidays.mjs",
    "test:rules": "vitest run tests/firestore.rules.test.ts",
    "build:demo": "tsc -b && vite build --mode demo --outDir dist-demo",
    "deploy:demo": "npm run build:demo && npx --yes firebase-tools@15.34.1 hosting:channel:deploy review --project moim-juno --config firebase.demo.json --expires 30d",
    "deploy": "npm run build && npx --yes firebase-tools@15.34.1 deploy --project moim-juno --only hosting,firestore:rules,firestore:indexes",
    "test:firebase": "playwright test -c playwright.firebase.config.ts",
    "licenses:update": "node scripts/collect-licenses.mjs"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^14.5.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "UNLICENSED",
  "author": "Yoo Junho"
}
